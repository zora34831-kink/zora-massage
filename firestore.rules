
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.owner == true;
    }

    function isActiveUser() {
      return signedIn()
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended != true
        );
    }

    // USER PRIVATE DATA
    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isOwner());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.verified == false
        && request.resource.data.suspended == false;

      allow update: if isOwner()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.verified == resource.data.verified
          && request.resource.data.suspended == resource.data.suspended
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name',
              'username',
              'photoUrl',
              'bio',
              'updatedAt'
            ])
        );

      allow delete: if isOwner();
    }

    // PUBLIC PROFILES
    match /publicProfiles/{uid} {
      allow read: if signedIn() && isActiveUser();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.verified == false;

      allow update: if isOwner()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.verified == resource.data.verified
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name',
              'username',
              'photoUrl',
              'bio',
              'updatedAt'
            ])
        );

      allow delete: if isOwner();
    }

    // PRIVATE CONVERSATIONS
    match /conversations/{conversationId} {
      allow read: if signedIn()
        && isActiveUser()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && isActiveUser()
        && request.auth.uid in request.resource.data.participants;

      allow update: if signedIn()
        && isActiveUser()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      allow delete: if isOwner();

      match /messages/{messageId} {
        allow read: if signedIn()
          && isActiveUser()
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if signedIn()
          && isActiveUser()
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid;

        allow update, delete: if isOwner();
      }
    }

    // GROUPS
    match /groups/{groupId} {
      allow read: if signedIn()
        && isActiveUser()
        && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && isActiveUser()
        && request.auth.uid in request.resource.data.members;

      allow update: if signedIn()
        && isActiveUser()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      allow delete: if isOwner();

      match /messages/{messageId} {
        allow read: if signedIn()
          && isActiveUser()
          && request.auth.uid in
            get(/databases/$(database)/documents/groups/$(groupId)).data.members;

        allow create: if signedIn()
          && isActiveUser()
          && request.auth.uid in
            get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && request.resource.data.senderId == request.auth.uid;

        allow update, delete: if isOwner();
      }
    }

    // ADMIN AUDIT LOG
    match /adminAudit/{auditId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
