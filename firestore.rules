
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && request.auth.token.owner == true;
    }

    function isActiveUser() {
      return signedIn() &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended != true
        );
    }

    match /users/{uid} {
      allow read: if signedIn() &&
        (request.auth.uid == uid || isOwner());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.verified == false
        && request.resource.data.suspended == false;

      allow update: if signedIn() && (
        (
          request.auth.uid == uid
          && request.resource.data.verified == resource.data.verified
          && request.resource.data.suspended == resource.data.suspended
          && request.resource.data.owner == resource.data.owner
        )
        || isOwner()
      );

      allow delete: if isOwner();
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn() && isActiveUser();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.verified == false;

      allow update: if signedIn() && (
        (
          request.auth.uid == uid
          && request.resource.data.verified == resource.data.verified
        )
        || isOwner()
      );

      allow delete: if isOwner();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && isActiveUser()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && isActiveUser()
        && request.auth.uid in request.resource.data.participants;

      allow update: if signedIn()
        && isActiveUser()
        && request.auth.uid in resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && isActiveUser()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participants;

        allow create: if signedIn()
          && isActiveUser()
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participants;

        allow update, delete: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if signedIn()
        && isActiveUser()
        && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && isActiveUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;

      allow update: if signedIn()
        && isActiveUser()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['name', 'members']);

      allow delete: if signedIn()
        && request.auth.uid == resource.data.ownerId;
    }

    match /groups/{groupId}/messages/{messageId} {
      allow read: if signedIn()
        && isActiveUser()
        && request.auth.uid in get(
          /databases/$(database)/documents/groups/$(groupId)
        ).data.members;

      allow create: if signedIn()
        && isActiveUser()
        && request.auth.uid == request.resource.data.senderId
        && request.auth.uid in get(
          /databases/$(database)/documents/groups/$(groupId)
        ).data.members;

      allow update, delete: if false;
    }

    match /adminAudit/{auditId} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
